{
  "name": "codebase-intelligence-engine",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Codebase Intelligence Engine (CIE): local-first codebase knowledge graph and living documentation.",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "packages/protocol",
    "packages/core",
    "packages/adapters",
    "packages/runtime"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && tsc -p tests/tsconfig.json",
    "test": "tsc --build && vitest run",
    "lint": "eslint .",
    "depcruise": "depcruise packages --config .dependency-cruiser.cjs",
    "metrics": "depcruise packages --config .dependency-cruiser.cjs --metrics --output-type metrics",
    "governance": "node scripts/check-governance.mjs",
    "verify": "npm run typecheck && npm run lint && npm run depcruise && npm test && npm run governance"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "dependency-cruiser": "18.7.0",
    "eslint": "9.39.5",
    "js-yaml": "5.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
