# Normalize line endings in the repository so golden fixtures and hashes match across Windows and Linux (WS-004, FF-DAT-006).
* text=auto eol=lf
*.wasm binary
*.db binary
# Cross-platform fixtures: deliberate CRLF content keeps its exact bytes; binaries are never normalized.
fixtures/**/crlf.txt -text
# Edge-case fixture files with deliberate bytes (BOM, CRLF, Latin-1): never normalized.
fixtures/edge-cases/src/bytes/** -text
*.bin binary
